# Configuración general de la aplicación
SECRET_KEY=super_secret_jwt_key_change_me_in_production_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Base de datos SQLite
DATABASE_URL=sqlite:///./auth_app.db

# Configuración de Brevo SMTP
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_username@smtp-brevo.com
BREVO_SMTP_PASSWORD=your_brevo_smtp_master_password
EMAILS_FROM_EMAIL=no-reply@yourdomain.com
EMAILS_FROM_NAME="Secure Auth System"